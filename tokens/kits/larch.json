{
  "$description": "Larch: soft and friendly. A cream page with lighter surfaces on it, separated by tint instead of borders, pill buttons, amber for the one highlight. Night is deep green, not black.",
  "kit": {
    "$description": "Larch: soft and friendly. A cream page with lighter surfaces on it, separated by tint instead of borders, pill buttons, amber for the one highlight. Night is deep green, not black.",
    "$extensions": {
      "io.brignano": {
        "selector": "[data-kit='larch']"
      }
    },
    "bg": {
      "$type": "color",
      "$value": {
        "light": "#f1eadc",
        "dark": "#0d1611"
      },
      "$description": "── Ground and surfaces ──"
    },
    "card": {
      "$type": "color",
      "$value": {
        "light": "#faf6ee",
        "dark": "#16211b"
      }
    },
    "surface-hover": {
      "$type": "color",
      "$value": {
        "light": "#f4eee1",
        "dark": "#1e2b24"
      }
    },
