{
  "$description": "Space on a 4px base, and the named stacking order.",
  "root": {
    "$extensions": {
      "io.brignano": {
        "selector": ":root"
      }
    },
    "z-raised": {
      "$value": "1",
      "$description": "── Stacking ─────────────────────────────────────────────────────────\nNamed by what sits above what. Dialogs, popovers and sheets use the\nbrowser's top layer and need none of these.\n\n  --z-raised  a control above its card's stretched link, a sticky th\n  --z-sticky  a header content scrolls under\n  --z-float   a label floating over the page (the rail's tooltip)\n  --z-skip    the skip link, above the header it skips\n  --z-toast   toasts, above everything not in the top layer"
    },
    "z-sticky": {
      "$value": "10"
    },
    "z-float": {
      "$value": "20"
    },
    "z-skip": {
      "$value": "30"
    },
    "z-toast": {
      "$value": "40"
    },
    "space-1": {
      "$value": "4px",
      "$description": "── Space ── 4px base. Tiers differ by which steps they reach for.",
      "$extensions": {
        "io.brignano": {
          "was": "s1"
        }
      }
    },
    "space-2": {
