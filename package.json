{
  "name": "@brignano/design",
  "version": "0.6.0",
  "description": "Shared design system for brignano surfaces \u2014 colour, type, space, shape, motion.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brignano/design.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "controls": "node scripts/controls.mjs",
    "search-index": "node scripts/search-index.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "tokens.css",
    "tokens.chart.css",
    "tokens/",
    "kits/",
    "themes/",
    "components.css",
    "controls.css",
    "product-page.css",
    "templates/",
    "icons/",
    "logo/",
    "scripts/fold.mjs",
    "scripts/email-tokens.mjs",
    "scripts/theme.mjs",
    "scripts/colour.mjs",
    "tailwind.css",
    "DESIGN.md",
    "decisions/"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./tokens.chart.css": "./tokens.chart.css",
    "./tokens/*": "./tokens/*",
    "./kits/*": "./kits/*",
    "./themes/*": "./themes/*",
    "./tailwind.css": "./tailwind.css",
    "./components.css": "./components.css",
    "./controls.css": "./controls.css",
    "./product-page.css": "./product-page.css",
    "./templates/*": "./templates/*",
    "./icons/*": "./icons/*",
    "./logo/*": "./logo/*",
    "./scripts/email-tokens.mjs": "./scripts/email-tokens.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
}
